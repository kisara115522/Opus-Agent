# Server
PORT=9900

# LLM Provider (openai / anthropic / dashscope)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=sk-your-key-here

# Embedding Provider (openai / dashscope)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=sk-your-key-here

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USERNAME=
MILVUS_PASSWORD=
MILVUS_DATABASE=default

# RAG
RAG_TOP_K=3
RAG_MODEL=gpt-4o

# Prometheus
PROMETHEUS_BASE_URL=http://localhost:9090
PROMETHEUS_MOCK_ENABLED=false

# CLS (Cloud Log Service)
CLS_MOCK_ENABLED=false

# Agent Guard
AGENT_GUARD_ENABLED=true
AGENT_FAILURE_THRESHOLD=3
AGENT_TOOL_CALL_LIMIT=12
AGENT_MODEL_CALL_LIMIT=25
