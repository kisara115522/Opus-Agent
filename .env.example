# Server
PORT=9900

# LLM Provider (openai / anthropic / dashscope)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=sk-your-key-here
# ANTHROPIC_API_KEY=sk-your-key-here
# DASHSCOPE_API_KEY=sk-your-key-here

# Embedding Provider (openai / dashscope)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USERNAME=
MILVUS_PASSWORD=
MILVUS_DATABASE=default
MILVUS_TIMEOUT=10000

# RAG
RAG_TOP_K=3
RAG_MODEL=gpt-4o

# Prometheus
PROMETHEUS_BASE_URL=http://localhost:9090
PROMETHEUS_TIMEOUT=10
PROMETHEUS_MOCK_ENABLED=false

# CLS (Cloud Log Service)
CLS_MOCK_ENABLED=false

# Agent Guard
AGENT_GUARD_ENABLED=true
AGENT_FAILURE_THRESHOLD=3
AGENT_TOOL_CALL_LIMIT=12
AGENT_MODEL_CALL_LIMIT=25
# AGENT_LIMIT_MESSAGE=达到重试上限，工具无法调用，请停止继续调用该工具并基于已有证据给出结论。

# Release Precheck
RELEASE_PRECHECK_ENABLED=true
RELEASE_PRECHECK_DEFAULT_TIMEOUT=900000
RELEASE_PRECHECK_HISTORY_FILE=./uploads/release-precheck-history.json
RELEASE_PRECHECK_WEIGHT_AUDIT_FILE=./uploads/release-precheck-weight-audit.json
SCORE_WEIGHT_PRODUCTION=15
SCORE_WEIGHT_PEAK_WINDOW=10
SCORE_WEIGHT_EMERGENCY=20
SCORE_WEIGHT_DATABASE_CHANGE=15
SCORE_WEIGHT_CONFIG_CHANGE=8
SCORE_WEIGHT_LARGE_CHANGE=12
SCORE_WEIGHT_ACTIVE_ALERTS=20
SCORE_WEIGHT_MISSING_RUNBOOK=15
SCORE_WEIGHT_RECENT_INCIDENT=10
SCORE_WEIGHT_MISSING_DEPLOYMENT_HISTORY=8

# Code Review
CODE_REVIEW_ENABLED=true
CODE_REVIEW_DEFAULT_TIMEOUT=900000
CODE_REVIEW_COMMAND_TIMEOUT_SECONDS=20
CODE_REVIEW_HISTORY_FILE=./uploads/code-review-history.json
CODE_REVIEW_MAX_COMMITS=30
CODE_REVIEW_MAX_FILES=200
CODE_REVIEW_MAX_PATCH_CHARS_PER_FILE=12000
CODE_REVIEW_BLOCK_SCORE=65
CODE_REVIEW_RAG_EVIDENCE_ENABLED=true
CODE_REVIEW_RAG_QUERIES_PER_REVIEW=3
CODE_REVIEW_AGENT_ENABLED=true
CODE_REVIEW_AGENT_MAX_FILES=8
CODE_REVIEW_AGENT_MAX_PATCH_CHARS_PER_FILE=4000
CODE_REVIEW_REQUIRE_ALLOWED_ROOTS=false
CODE_REVIEW_ALLOWED_ROOTS=.

# Document Chunking
DOCUMENT_CHUNK_MAX_SIZE=800
DOCUMENT_CHUNK_OVERLAP=100

# File Upload
FILE_UPLOAD_PATH=./uploads
FILE_UPLOAD_ALLOWED_EXTENSIONS=txt,md
